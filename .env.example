# Where the original brand images live.
# Default (empty) = load them from the live site https://www.eteamworks.com/visuals
# After running `npm run fetch-assets`, set this to /visuals to serve them from your own host.
VITE_ASSET_BASE=

# Where the contact form POSTs JSON. Default: /api/contact (Vercel function included in /api)
# You can also use Formspree / Web3Forms / your own CRM endpoint.
VITE_FORM_ENDPOINT=

# Public site URL, used for canonical links
VITE_SITE_URL=https://www.eteamworks.com

# --- Server-side only (set in Vercel dashboard, never prefixed with VITE_) ---
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@eteamworks.com
# CONTACT_FROM_EMAIL=Teamworks Website <no-reply@your-verified-domain.com>
